# UdiFy configuration template — copy to .env and fill in.
# .env itself is git-ignored; never put real values in this .example file.
#
# UdiFy is LIVE-only — every value below is required before the app will
# start a run. See:
#   governance/planning/UDIFY-SPECIFICATIONS.md
#   -> "UDIFY — CREDENTIALS, MOCKING AND LIVE VERIFICATION DECISION"

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SPREADSHEET_ID_OGR=
GOOGLE_SPREADSHEET_ID_UDISE=
GOOGLE_SPREADSHEET_ID_PEN=

# --- Government portal credentials ---
# Never hardcoded, never logged. Exact secure-storage mechanism (env var
# vs. an OS credential store) is a CODING-time decision; env vars shown
# here as the minimum-viable local convention.
GUJARAT_UDISE_LOGIN_URL=
GUJARAT_UDISE_SCHOOL_CODE=
GUJARAT_UDISE_USERNAME=
GUJARAT_UDISE_PASSWORD=
NATIONAL_UDISE_PLUS_LOGIN_URL=
NATIONAL_UDISE_PLUS_USERNAME=
NATIONAL_UDISE_PLUS_PASSWORD=

# --- Diagnostics ---
UDIFY_DIAGNOSTICS_DIR=diagnostics
UDIFY_LOG_LEVEL=INFO
