# Disposable/ephemeral workspace (RULEBOOK.md §B) — never production, never continuity
Scratch/

# Secrets — never tracked (RULEBOOK.md §J6)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
credentials/
**/credentials/
*.credentials.json
service-account*.json
token.json
token.pickle

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# NOTE: there is deliberately no PyInstaller/packaging section here.
# UdiFy is launched from source on this machine (`.venv\Scripts\
# pythonw.exe run_udify.py` via a Start Menu shortcut) because Windows
# Smart App Control blocks unsigned .exe files here, and no packaging
# target could produce a launchable one. The `installer.spec` /
# `installer.iss` build targets were removed on 2026-09-27 at the user's
# request rather than left in place as dead configuration - see
# governance/ai-context/SESSION-2026-09-27-1.md and the "Packaging
# removed" section of governance/planning/TODO.md.

# SQLite local state (workflow/audit DB — never shipped, never committed)
*.sqlite3
*.db

# Playwright
playwright-report/
test-results/

# Diagnostics/screenshots captured by the app at runtime
diagnostics/
screenshots/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ad hoc debug/launch output (never a source of truth — see diagnostics/)
*.log

# Source screen recordings — the evidence base the master spec was derived
# from, kept local only by explicit user decision 2026-09-27. Binary, large,
# and derived from school operations; the conclusions are already recorded
# in governance/planning/UDIFY-SPECIFICATIONS.md, so the videos themselves
# are not needed to build, test, or audit the project.
UDISE/
*.mp4
