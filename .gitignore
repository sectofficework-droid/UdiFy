# Disposable/ephemeral workspace (RULEBOOK.md §B) — never production, never continuity
Scratch/

# Secrets — never tracked (RULEBOOK.md §J6)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
credentials/
**/credentials/
*.credentials.json
service-account*.json
token.json
token.pickle

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# PyInstaller
*.spec
!installer.spec
!installer-onefile.spec

# Built executables (built artifacts, never committed — see dist/ above;
# this one is exceptionally placed at repo root per user request 2026-09-26)
/UdiFy.exe

# Inno Setup installer output (installer.iss itself is tracked, the
# compiled UdiFy-Setup.exe it produces is a build artifact like dist/)
dist_installer/

# SQLite local state (workflow/audit DB — never shipped, never committed)
*.sqlite3
*.db

# Playwright
playwright-report/
test-results/

# Diagnostics/screenshots captured by the app at runtime
diagnostics/
screenshots/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ad hoc debug/launch output (never a source of truth — see diagnostics/)
*.log

# Source screen recordings — the evidence base the master spec was derived
# from, kept local only by explicit user decision 2026-09-27. Binary, large,
# and derived from school operations; the conclusions are already recorded
# in governance/planning/UDIFY-SPECIFICATIONS.md, so the videos themselves
# are not needed to build, test, or audit the project.
UDISE/
*.mp4
